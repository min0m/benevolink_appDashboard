@page "/events"
@attribute [Authorize]
@inject PlatformService Platform
@inject OperationsService Ops
@inject AuthenticationStateProvider AuthState

@if (_model is null || _events is null)
{
    <section class="loading-stage"><div class="spinner"></div><strong>Loading event operations…</strong></section>
}
else
{
    <PageHero Eyebrow="Events" Title="Calendar & Participation" Subtitle="Register, cancel, validate attendance, and create events with real MySQL-backed actions." />
    <KpiStrip Items="@_model.Kpis" />

    @if (CanManage)
    {
        <form class="creation-panel pro-form-card" method="post" action="/actions/event/create">
            <input type="hidden" name="returnUrl" value="/events" />
            <div>
                <div class="eyebrow">Event studio</div>
                <h3>Create event</h3>
                <p>Creates the event inside the BenevoLink action tables and mirrors into your legacy schema when possible.</p>
            </div>
            <div class="creation-grid">
                <input class="control-input" name="title" placeholder="Event title" required />
                <input class="control-input" name="location" placeholder="Location" />
                <input class="control-input" name="date" type="date" value='@DateTime.Today.AddDays(14).ToString("yyyy-MM-dd")' />
                <button type="submit" class="btn primary">Create event</button>
            </div>
        </form>
    }

    <section class="mission-market">
        @foreach (var item in _events)
        {
            <article class="mission-tile mission-tile-fixed">
                <div class="entity-head">
                    <span class="source-chip">@item.Source</span>
                    <StatusPill Text="@item.Status" />
                </div>
                <h3>@item.Title</h3>
                <div class="mission-meta">
                    <span>📍 @item.Location</span>
                    <span>🗓 @item.Date</span>
                    <span>🎟 @item.RegistrationStatus</span>
                </div>
                <div class="mission-actions form-actions">
                    @if (CanRegister(item))
                    {
                        <form method="post" action="/actions/event/register" class="inline-action-form">
                            <input type="hidden" name="returnUrl" value="/events" />
                            <input type="hidden" name="eventId" value="@item.Id" />
                            <button type="submit" class="btn primary">Register</button>
                        </form>
                    }
                    else if (_user?.Role == "Volunteer")
                    {
                        <form method="post" action="/actions/event/cancel" class="inline-action-form">
                            <input type="hidden" name="returnUrl" value="/events" />
                            <input type="hidden" name="eventId" value="@item.Id" />
                            <button type="submit" class="btn danger-soft">Cancel registration</button>
                        </form>
                    }

                    @if (CanManage)
                    {
                        <form method="post" action="/actions/event/validate" class="review-form wide-review-form">
                            <input type="hidden" name="returnUrl" value="/events" />
                            <input type="hidden" name="eventId" value="@item.Id" />
                            <div class="inline-row">
                                <input class="control-input compact-input" name="volunteerId" placeholder="Volunteer/User ID" required />
                                <input class="control-input tiny-input" name="hours" type="number" step="0.5" min="0.5" value="1" />
                                <button type="submit" class="btn ghost">Validate attendance</button>
                            </div>
                        </form>
                        <form method="post" action="/actions/event/status" class="inline-action-form">
                            <input type="hidden" name="returnUrl" value="/events" />
                            <input type="hidden" name="eventId" value="@item.Id" />
                            <input type="hidden" name="status" value="Open" />
                            <button type="submit" class="btn ghost">Open</button>
                        </form>
                        <form method="post" action="/actions/event/status" class="inline-action-form">
                            <input type="hidden" name="returnUrl" value="/events" />
                            <input type="hidden" name="eventId" value="@item.Id" />
                            <input type="hidden" name="status" value="Closed" />
                            <button type="submit" class="btn danger-soft">Close</button>
                        </form>
                    }
                </div>
            </article>
        }
    </section>

    @foreach (var grid in _model.Grids)
    {
        <DataGridView Grid="@grid" />
    }
}

@code {
    private WorkspaceModel? _model;
    private IReadOnlyList<EventActionItem>? _events;
    private AppUser? _user;
    private bool CanManage => _user?.Role is "Organization" or "Admin";
    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _user = AppUser.FromClaims(state.User);
        _model = await Platform.EventsAsync();
        _events = await Ops.ListEventsAsync(_user);
    }
    private static bool CanRegister(EventActionItem item) => !item.RegistrationStatus.Contains("Registered", StringComparison.OrdinalIgnoreCase) && !item.RegistrationStatus.Contains("Attended", StringComparison.OrdinalIgnoreCase);
}
